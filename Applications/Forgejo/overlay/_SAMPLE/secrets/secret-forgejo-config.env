# Server -- https://forgejo.org/docs/latest/admin/config-cheat-sheet/#server-server
FORGEJO__server__DOMAIN=git.home.essing.org
FORGEJO__server__ROOT_URL=https://git.home.essing.org/
FORGEJO__server__HTTP_PORT=3000
FORGEJO__server__APP_DATA_PATH=/data
FORGEJO__server__OFFLINE_MODE=false
FORGEJO__server__LANDING_PAGE=login
FORGEJO__server__START_SSH_SERVER=true
FORGEJO__server__SSH_DOMAIN=git.home.essing.org
FORGEJO__server__SSH_PORT=22
FORGEJO__server__SSH_LISTEN_HOST=0.0.0.0
FORGEJO__server__SSH_LISTEN_PORT=2222
FORGEJO__server__SSH_CREATE_AUTHORIZED_KEYS_FILE=true
FORGEJO__server__SSH_AUTHORIZED_KEYS_BACKUP=false
FORGEJO__server__PER_WRITE_TIMEOUT=60s
FORGEJO__server__PER_WRITE_PER_KB_TIMEOUT=10s

# Database -- https://forgejo.org/docs/latest/admin/config-cheat-sheet/#database-database
FORGEJO__database__DB_TYPE=postgres
FORGEJO__database__HOST=postgres-database-rw.postgres.svc.apps02.home.essing.org:5432
FORGEJO__database__NAME=forgejo
FORGEJO__database__SCHEMA=public
FORGEJO__database__SSL_MODE=require
FORGEJO__database__SLOW_QUERY_THRESHOLD=2s

# Security -- https://forgejo.org/docs/latest/admin/config-cheat-sheet/#security-security
FORGEJO__security__INSTALL_LOCK=true
FORGEJO__security__LOGIN_REMEMBER_DAYS=365
FORGEJO__security__PASSWORD_HASH_ALGO=pbkdf2_hi
FORGEJO__security__PASSWORD_COMPLEXITY=lower,upper,digit,spec
FORGEJO__security__MIN_PASSWORD_LENGTH=12
FORGEJO__security__DISABLE_GIT_HOOKS=true

# Service -- https://forgejo.org/docs/latest/admin/config-cheat-sheet/#service-service
FORGEJO__service__DISABLE_REGISTRATION=true
FORGEJO__service__REQUIRE_SIGNIN_VIEW=true
FORGEJO__service__ENABLE_CAPTCHA=false
FORGEJO__service__USERNAME_COOLDOWN_PERIOD=7
FORGEJO__service__MAX_USER_REDIRECTS=5
FORGEJO__service__SHOW_REGISTRATION_BUTTON=false
FORGEJO__service__DEFAULT_KEEP_EMAIL_PRIVATE=true
FORGEJO__service__DEFAULT_ENABLE_TIMETRACKING=true

# UI -- https://forgejo.org/docs/latest/admin/config-cheat-sheet/#ui-ui
FORGEJO__ui__ONLY_SHOW_RELEVANT_REPOS=true
FORGEJO__ui__DEFAULT_THEME=forgejo-auto

# Cache -- https://forgejo.org/docs/latest/admin/config-cheat-sheet/#cache-cache
FORGEJO__cache__ADAPTER=twoqueue
FORGEJO__cache__HOST={"size":100, "recent_ratio":0.25, "ghost_ratio":0.5}

# Session -- https://forgejo.org/docs/latest/admin/config-cheat-sheet/#session-session
FORGEJO__session__PROVIDER=file
FORGEJO__session__PROVIDER_CONFIG=/data/sessions
FORGEJO__session__COOKIE_SECURE=true

# Repository -- https://forgejo.org/docs/latest/admin/config-cheat-sheet/#repository-repository
FORGEJO__repository__ROOT=/data/git/repositories
FORGEJO__repository__DEFAULT_BRANCH=main
FORGEJO__repository__DISABLE_HTTP_GIT=false
FORGEJO__repository.signing__DEFAULT_TRUST_MODEL=committer

# Storage -- https://forgejo.org/docs/latest/admin/setup/storage/
FORGEJO__attachment__STORAGE_TYPE=local
FORGEJO__attachment__PATH=/data/attachments
FORGEJO__lfs__STORAGE_TYPE=local
FORGEJO__lfs__PATH=/data/lfs
FORGEJO__picture__AVATAR_UPLOAD_PATH=/data/avatars
FORGEJO__picture__REPOSITORY_AVATAR_UPLOAD_PATH=/data/repo-avatars
FORGEJO__repo-archive__STORAGE_TYPE=local
FORGEJO__repo-archive__PATH=/data/repo-archive
FORGEJO__packages__STORAGE_TYPE=local
FORGEJO__packages__PATH=/data/packages
FORGEJO__packages__CHUNKED_UPLOAD_PATH=/data/tmp/package-upload

# Indexer
FORGEJO__indexer__ISSUE_INDEXER_PATH=/data/indexers/issues.bleve
FORGEJO__indexer__REPO_INDEXER_ENABLED=true
FORGEJO__indexer__REPO_INDEXER_PATH=/data/indexers/repos.bleve

# Queue
FORGEJO__queue__TYPE=level
FORGEJO__queue__DATADIR=/data/queues

# Log
FORGEJO__log__ROOT_PATH=/data/log
FORGEJO__log__MODE=console
FORGEJO__log__LEVEL=info

# Actions -- https://forgejo.org/docs/latest/admin/actions/
FORGEJO__actions__ENABLED=true
FORGEJO__actions__DEFAULT_ACTIONS_URL=https://code.forgejo.org

# Mailer -- https://forgejo.org/docs/latest/admin/setup/email/
FORGEJO__mailer__ENABLED=true
FORGEJO__mailer__PROTOCOL=smtps
FORGEJO__mailer__SMTP_ADDR=securesmtp.t-online.de
FORGEJO__mailer__SMTP_PORT=465
FORGEJO__mailer__USER=###PLACEHOLDER_SMTP_USER###
FORGEJO__mailer__PASSWD=###PLACEHOLDER_SMTP_PASSWORD###
FORGEJO__mailer__FROM="Forgejo <###PLACEHOLDER_SMTP_USER###>"
