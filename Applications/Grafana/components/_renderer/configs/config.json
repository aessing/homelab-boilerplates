{
  "service": {
    "host": "0.0.0.0",
    "port": 8081,
    "protocol": "http",
    "certFile": "",
    "certKey": "",
    "minTLSVersion": "TLSv1.2",

    "metrics": {
      "enabled": false,
      "collectDefaultMetrics": true,
      "requestDurationBuckets": [1, 5, 7, 9, 11, 13, 15, 20, 30]
    },

    "logging": {
      "level": "info",
      "console": {
        "json": false,
        "colorize": true
      }
    },

    "rateLimiter": {
      "enabled": false,
      "redisHost": null,
      "redisPort": null,
      "requestsPerSecond": 5
    }
  },

  "rendering": {
    "chromeBin": null,
    "args": ["--no-sandbox", "--disable-gpu"],
    "ignoresHttpsErrors": false,

    "timezone": "Europe/Berlin",
    "acceptLanguage": "de-DE, de;q=0.9, en;q=0.8, *;q=0.5",
    "width": 1000,
    "height": 500,
    "deviceScaleFactor": 1,
    "maxWidth": 3080,
    "maxHeight": 3080,
    "maxDeviceScaleFactor": 4,
    "pageZoomLevel": 1,
    "headed": false,

    "mode": "clustered",
    "emulateNetworkConditions": false,
    "clustering": {
      "monitor": false,
      "mode": "browser",
      "maxConcurrency": 5,
      "timeout": 30
    },

    "verboseLogging": false,
    "dumpio": false,
    "timingMetrics": false,

    "tracing": {
      "url": "",
      "serviceName": "grafana-oss-renderer"
    }
  }
}
