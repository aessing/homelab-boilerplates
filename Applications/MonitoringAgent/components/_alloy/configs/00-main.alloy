logging {
  level  = "info"
  format = "json"
}

local.file "remote_write_token" {
  filename  = "/var/run/secrets/monitoring-agent/token"
  is_secret = true
}

prometheus.remote_write "central" {
  endpoint {
    name = "central-victoriametrics"
    url  = sys.env("REMOTE_WRITE_URL")

    authorization {
      type        = "Bearer"
      credentials = local.file.remote_write_token.content
    }

    tls_config {
      min_version = "TLS12"
    }

    queue_config {
      min_shards            = 1
      max_shards            = 4
      capacity              = 2500
      max_samples_per_send  = 1000
      batch_send_deadline   = "5s"
      min_backoff           = "100ms"
      max_backoff           = "10s"
      retry_on_http_429     = true
      sample_age_limit      = "0s"
    }
  }

  wal {
    truncate_frequency = "2h"
    min_keepalive_time = "5m"
    max_keepalive_time = "8h"
  }
}

discovery.kubernetes "nodes" {
  role = "node"
}

discovery.relabel "kubelet" {
  targets = discovery.kubernetes.nodes.targets

  rule {
    source_labels = ["__meta_kubernetes_node_name"]
    target_label  = "node"
  }
}

prometheus.scrape "kubelet" {
  targets         = discovery.relabel.kubelet.output
  job_name        = "kubelet"
  scheme          = "https"
  metrics_path    = "/metrics"
  scrape_interval = sys.env("SLOW_SCRAPE_INTERVAL")
  scrape_timeout  = "50s"
  forward_to      = [prometheus.relabel.k3s_metrics.receiver]

  authorization {
    type             = "Bearer"
    credentials_file = "/var/run/secrets/kubernetes.io/serviceaccount/token"
  }

  tls_config {
    ca_file = "/var/run/secrets/kubernetes.io/serviceaccount/ca.crt"
  }
}

prometheus.scrape "cadvisor" {
  targets         = discovery.relabel.kubelet.output
  job_name        = "cadvisor"
  scheme          = "https"
  metrics_path    = "/metrics/cadvisor"
  scrape_interval = sys.env("FAST_SCRAPE_INTERVAL")
  scrape_timeout  = "10s"
  forward_to      = [prometheus.remote_write.central.receiver]

  authorization {
    type             = "Bearer"
    credentials_file = "/var/run/secrets/kubernetes.io/serviceaccount/token"
  }

  tls_config {
    ca_file = "/var/run/secrets/kubernetes.io/serviceaccount/ca.crt"
  }
}

discovery.kubernetes "node_exporter_pods" {
  role = "pod"

  selectors {
    role  = "pod"
    label = "app.kubernetes.io/name=monitoring-agent,app.kubernetes.io/component=node-exporter"
  }

  namespaces {
    own_namespace = true
  }
}

discovery.relabel "node_exporter" {
  targets = discovery.kubernetes.node_exporter_pods.targets

  rule {
    source_labels = ["__meta_kubernetes_pod_phase"]
    regex         = "Running"
    action        = "keep"
  }

  rule {
    source_labels = ["__meta_kubernetes_pod_container_port_name"]
    regex         = "metrics"
    action        = "keep"
  }

  rule {
    source_labels = ["__meta_kubernetes_pod_node_name"]
    target_label  = "node"
  }

  rule {
    source_labels = ["__meta_kubernetes_pod_name"]
    target_label  = "pod"
  }
}

prometheus.scrape "node_exporter" {
  targets         = discovery.relabel.node_exporter.output
  job_name        = "node-exporter"
  scrape_interval = sys.env("FAST_SCRAPE_INTERVAL")
  scrape_timeout  = "10s"
  forward_to      = [prometheus.remote_write.central.receiver]
}

prometheus.scrape "kube_state_metrics" {
  targets = [
    {
      "__address__" = "kube-state-metrics:8080",
      "instance"    = "kube-state-metrics",
    },
  ]
  job_name        = "kube-state-metrics"
  scrape_interval = sys.env("SLOW_SCRAPE_INTERVAL")
  scrape_timeout  = "50s"
  forward_to      = [prometheus.remote_write.central.receiver]
}

prometheus.scrape "kube_state_metrics_self" {
  targets = [
    {
      "__address__" = "kube-state-metrics:8081",
      "instance"    = "kube-state-metrics",
    },
  ]
  job_name        = "kube-state-metrics-self"
  scrape_interval = sys.env("NORMAL_SCRAPE_INTERVAL")
  scrape_timeout  = "10s"
  forward_to      = [prometheus.remote_write.central.receiver]
}

prometheus.scrape "alloy_self" {
  targets = [
    {
      "__address__" = "127.0.0.1:12345",
      "instance"    = sys.env("CLUSTER_NAME"),
    },
  ]
  job_name        = "alloy"
  scrape_interval = sys.env("NORMAL_SCRAPE_INTERVAL")
  scrape_timeout  = "10s"
  forward_to      = [prometheus.remote_write.central.receiver]
}

discovery.kubernetes "application_pods" {
  role = "pod"

  selectors {
    role  = "pod"
    label = "monitoring-metrics-scrape=true"
  }
}

discovery.relabel "applications" {
  targets = discovery.kubernetes.application_pods.targets

  rule {
    source_labels = ["__meta_kubernetes_pod_phase"]
    regex         = "Running"
    action        = "keep"
  }

  rule {
    source_labels = ["__meta_kubernetes_pod_container_port_name"]
    regex         = "metrics"
    action        = "keep"
  }

  rule {
    source_labels = ["__meta_kubernetes_namespace"]
    target_label  = "namespace"
  }

  rule {
    source_labels = ["__meta_kubernetes_pod_name"]
    target_label  = "pod"
  }

  rule {
    source_labels = ["__meta_kubernetes_pod_container_name"]
    target_label  = "container"
  }

  rule {
    source_labels = ["__meta_kubernetes_pod_node_name"]
    target_label  = "node"
  }
}

prometheus.scrape "applications" {
  targets         = discovery.relabel.applications.output
  job_name        = "kubernetes-applications"
  scrape_interval = sys.env("NORMAL_SCRAPE_INTERVAL")
  scrape_timeout  = "20s"
  forward_to      = [prometheus.remote_write.central.receiver]
}
