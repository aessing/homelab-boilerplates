prometheus.scrape "unifi_collector" {
  targets = [{
    "__address__" = "alloy-unifi.unpoller.svc:12345",
    "job"         = "alloy-unifi",
    "instance"    = "alloy-unifi",
  }]
  job_name        = "alloy-unifi"
  scrape_interval = sys.env("NORMAL_SCRAPE_INTERVAL")
  scrape_timeout  = "10s"
  forward_to      = [prometheus.remote_write.central.receiver]
}
