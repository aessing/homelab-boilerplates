        "colorMode": "background_solid",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showPercentChange": false,
        "textMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "monitoring-metrics"
          },
          "editorMode": "code",
          "expr": "max(clamp_min(time() - timestamp(up{cluster=~\"$cluster\"}), 0))",
          "format": "time_series",
          "instant": true,
          "interval": "15s",
          "legendFormat": "",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Oldest observed target sample",
      "type": "stat"
    },
