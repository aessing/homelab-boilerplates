    {
      "datasource": {
        "type": "prometheus",
        "uid": "monitoring-metrics"
      },
      "description": "Age of the oldest currently returned target sample. A missing result is N/A.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "custom": {},
          "decimals": 2,
          "mappings": [],
          "noValue": "N/A",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
