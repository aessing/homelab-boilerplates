# Frontend Configuration
VITE_ENABLE_DB=true
VITE_AUTH_AUTHORITY=###OAUTH2_CONFIGURATION_ISSUER_URL###
VITE_AUTH_REDIRECT_URI=###REDIRECT_URI_AFTER_LOGIN###
VITE_AUTH_POST_LOGOUT_REDIRECT_URI=###POST_LOGOUT_REDIRECT_URL###
VITE_AUTH_SCOPE=openid profile email groups patient_ids
VITE_AUTH_GROUP_EDITORS=###EDITORS_GROUP_NAME###
VITE_AUTH_GROUP_READERS=###READERS_GROUP_NAME###
VITE_AUTH_GROUP_PATIENTS=###PATIENTS_GROUP_NAME###
VITE_AUTH_PATIENT_IDS_CLAIM=patient_ids

# Backend Configuration
AUTH_ENABLED=true
AUTH_ISSUER=###OAUTH2_CONFIGURATION_ISSUER_URL###
AUTH_JWKS_URI=###OAUTH2_JWKS_URL###
AUTH_GROUP_EDITORS=###EDITORS_GROUP_NAME###
AUTH_GROUP_READERS=###READERS_GROUP_NAME###
AUTH_GROUP_PATIENTS=###PATIENTS_GROUP_NAME###
AUTH_PATIENT_IDS_CLAIM=patient_ids

# Database Configuration
PORT=4173
API_BASE_PATH=/api/db
DB_HOST=###POSTGRES_HOST###
DB_PORT=5432
DB_NAME=###POSTGRES_DB###
DB_USER=###POSTGRES_USER###
DB_SSL=require

# Security and CORS
API_HOST=0.0.0.0
CORS_ORIGINS=###FQDN_OF_APPLICATION###
NODE_ENV=production
